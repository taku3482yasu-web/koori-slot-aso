+    // 出すかどうか・どれを出すかは内部処理の notice (iwakan)。ここは見せ方だけ
+    function iwakan(type) {
+        const dur = IWAKAN_MS[type] || 600;
+        if (type === 'navGlitch' || type === 'navQuestion') {
+            v.navOdd = { type: type === 'navGlitch' ? 'glitch' : 'question', until: now + dur };
+            sound.play('glitch');
